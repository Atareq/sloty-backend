# Production Django configuration. Fill on the host; never commit filled values.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.sloty.baronlearning.com

DB_ENGINE=postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=

# Optional settings; these match the defaults in config/settings/base.py.
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
SQL_QUERY_STATS_ENABLED=false
SQL_QUERY_STATS_VERBOSE=false
SQL_QUERY_STATS_WARN_QUERY_COUNT=1
SQL_QUERY_STATS_SLOW_QUERY_MS=100
SQL_QUERY_STATS_SLOW_REQUEST_MS=500
SQL_QUERY_STATS_MAX_QUERY_SAMPLES=5
SQL_QUERY_STATS_MAX_SQL_LENGTH=500

# Public image CDN and private Cloudflare R2 write credentials. Keep the
# credential values only in this host-local file, never in Git.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_IMAGE=sloty-prod-images
IMAGES_PUBLIC_BASE_URL=https://images.sloty.baronlearning.com
IMAGE_MAX_UPLOAD_BYTES=10485760
IMAGE_MAX_WIDTH=8192
IMAGE_MAX_HEIGHT=8192
IMAGE_MAX_PIXELS=40000000
