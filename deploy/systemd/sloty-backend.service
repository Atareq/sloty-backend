[Unit]
Description=Sloty Django backend
After=network.target

[Service]
User=sloty
Group=sloty
WorkingDirectory=/srv/sloty/backend
EnvironmentFile=/etc/sloty/env/prod.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/srv/sloty/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8020
Restart=on-failure

[Install]
WantedBy=multi-user.target
