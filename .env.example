# Copy this file to .env for local development.
# Use a unique secret locally; never commit real secrets.
SECRET_KEY=change-me-for-local-development-only

# Use True only in local development.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local default is SQLite.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# PostgreSQL example values. Leave blank when using SQLite.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSLMODE=

# JWT lifetimes. Access defaults to 60 minutes; refresh defaults to 7 days.
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Optional SQL request performance logs. Safe to enable without DEBUG.
# Default warning threshold is 1 query so request cost stays visible.
SQL_QUERY_STATS_ENABLED=false
SQL_QUERY_STATS_VERBOSE=false
SQL_QUERY_STATS_WARN_QUERY_COUNT=1
SQL_QUERY_STATS_SLOW_QUERY_MS=100
SQL_QUERY_STATS_SLOW_REQUEST_MS=500
SQL_QUERY_STATS_MAX_QUERY_SAMPLES=5
SQL_QUERY_STATS_MAX_SQL_LENGTH=500

# ---------------------------------------------------------------------------
# CAPTCHA (off by default)
# ---------------------------------------------------------------------------
# Applied to login only. It is never applied to the public availability link —
# that is a page players are meant to open from a shared URL.
#
# Verification fails closed: if the provider cannot be reached the request is
# rejected. CAPTCHA_ENABLED=false is the kill switch for a provider outage and
# takes effect without a deploy.
CAPTCHA_ENABLED=false
# turnstile (default) | recaptcha | hcaptcha
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_TIMEOUT_SECONDS=5
# Score-based providers only (reCAPTCHA v3). Leave blank for Turnstile/hCaptcha.
CAPTCHA_MIN_SCORE=
