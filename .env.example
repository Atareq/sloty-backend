# Copy this file to .env for local development.
# Use a unique secret locally; never commit real secrets.
SECRET_KEY=change-me-for-local-development-only

# Use True only in local development.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local default is SQLite.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# PostgreSQL example values. Leave blank when using SQLite.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSLMODE=

# JWT lifetimes. Access defaults to 60 minutes; refresh defaults to 7 days.
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Optional SQL request performance logs. Safe to enable without DEBUG.
# Default warning threshold is 1 query so request cost stays visible.
SQL_QUERY_STATS_ENABLED=false
SQL_QUERY_STATS_VERBOSE=false
SQL_QUERY_STATS_WARN_QUERY_COUNT=1
SQL_QUERY_STATS_SLOW_QUERY_MS=100
SQL_QUERY_STATS_SLOW_REQUEST_MS=500
SQL_QUERY_STATS_MAX_QUERY_SAMPLES=5
SQL_QUERY_STATS_MAX_SQL_LENGTH=500

# ---------------------------------------------------------------------------
# Cache / Redis
# ---------------------------------------------------------------------------
# Leave blank to use the per-process local-memory cache (fine for SQLite dev and
# the test suite). Set it for anything that needs a cache shared across workers.
# Docker stacks use the compose service name: redis://redis:6379/0
REDIS_URL=

# ---------------------------------------------------------------------------
# Docker (docker/dev and docker/prod)
# ---------------------------------------------------------------------------
# Both stacks read this same file. To run them, switch the database above to
# PostgreSQL and point the hosts at the compose service names:
#   DB_ENGINE=postgres
#   DB_HOST=db
#   REDIS_URL=redis://redis:6379/0
#
# Host port the API is published on.
WEB_PORT=8000
# Host ports for the database and cache containers. Change these if something
# already listens on 5432 / 6379 on your machine.
DB_PORT_PUBLISHED=5432
REDIS_PORT_PUBLISHED=6379
# gunicorn tuning for the production image only.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
