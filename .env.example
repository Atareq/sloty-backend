# Copy this file to .env for local development.
# Use a unique secret locally; never commit real secrets.
SECRET_KEY=change-me-for-local-development-only

# Use True only in local development.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local default is SQLite.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# PostgreSQL example values. Leave blank when using SQLite.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSLMODE=

# JWT lifetimes. Access defaults to 60 minutes; refresh defaults to 7 days.
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Optional SQL request performance logs. Safe to enable without DEBUG.
# Default warning threshold is 1 query so request cost stays visible.
SQL_QUERY_STATS_ENABLED=false
SQL_QUERY_STATS_VERBOSE=false
SQL_QUERY_STATS_WARN_QUERY_COUNT=1
SQL_QUERY_STATS_SLOW_QUERY_MS=100
SQL_QUERY_STATS_SLOW_REQUEST_MS=500
SQL_QUERY_STATS_MAX_QUERY_SAMPLES=5
SQL_QUERY_STATS_MAX_SQL_LENGTH=500

# ---------------------------------------------------------------------------
# Rate limiting (unauthenticated endpoints only)
# ---------------------------------------------------------------------------
# Authenticated club traffic is never throttled. Leave a value blank to disable
# that bucket. Production REQUIRES REDIS_URL: on the local-memory cache the
# counters are per gunicorn worker, so the real limit becomes workers x rate.
# `manage.py check --deploy` fails on that misconfiguration.
THROTTLE_AUTH_LOGIN_IP=10/min
THROTTLE_AUTH_LOGIN_USERNAME=5/min
THROTTLE_AUTH_REFRESH=60/min
THROTTLE_PUBLIC_AVAILABILITY=120/min
THROTTLE_PUBLIC_STATIC=60/min

# Number of trusted reverse proxies in front of the app. Behind Nginx set this
# to 1, or every anonymous caller is throttled as a single shared client.
NUM_PROXIES=0

# Cache backend. Leave blank for the per-process local-memory cache. Rate
# limiting REQUIRES a shared cache in production (see THROTTLE_* above).
# Docker stacks use the compose service name: redis://redis:6379/0
REDIS_URL=
