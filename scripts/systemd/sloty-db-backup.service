[Unit]
Description=Sloty PostgreSQL backup to Cloudflare R2
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/sloty/env/prod.env
EnvironmentFile=/etc/sloty/env/backup.env
ExecStart=/srv/sloty/backend/scripts/backup-sloty-db
UMask=0077
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/sloty
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
