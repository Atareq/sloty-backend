#!/usr/bin/env bash
# Canonical production deploy entrypoint.
#
# Usage:
#   deploy-sloty-backend <COMMIT_SHA> <RELEASE_TAG>
#
# This script belongs exclusively to Sloty. It must never manage shared
# infrastructure (system Python, PostgreSQL, Nginx, or other projects).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/backend-release.sh
source "${SCRIPT_DIR}/lib/backend-release.sh"

COMMIT_SHA="${1:-}"
RELEASE_TAG="${2:-}"

SLOTY_PYTHON_RUNTIME_ROOT="${SLOTY_PYTHON_RUNTIME_ROOT:-/opt/sloty-runtime/python}"
SLOTY_REQUIRED_PYTHON_VERSION="${SLOTY_REQUIRED_PYTHON_VERSION:-3.12.14}"
SLOTY_BACKEND_SERVICE="${SLOTY_BACKEND_SERVICE:-sloty-backend.service}"
SLOTY_HEALTH_URL="${SLOTY_HEALTH_URL:-http://127.0.0.1:8020/health/}"
SLOTY_HEALTH_HOST="${SLOTY_HEALTH_HOST:-api.sloty.baronlearning.com}"
SLOTY_HEALTH_ATTEMPTS="${SLOTY_HEALTH_ATTEMPTS:-10}"
SLOTY_HEALTH_RETRY_SLEEP="${SLOTY_HEALTH_RETRY_SLEEP:-1}"
SLOTY_ETC_DIR="${SLOTY_ETC_DIR:-/etc/sloty}"
SLOTY_BACKEND_ENV_FILE="${SLOTY_BACKEND_ENV_FILE:-${SLOTY_ETC_DIR}/backend.env}"
SLOTY_RELEASE_FILE="${SLOTY_RELEASE_FILE:-${SLOTY_ETC_DIR}/backend-release.json}"
SLOTY_DJANGO_SETTINGS="${SLOTY_DJANGO_SETTINGS:-config.settings.production}"
SLOTY_EXPECTED_ORIGIN="${SLOTY_EXPECTED_ORIGIN:-git@github.com:Atareq/sloty-backend.git}"
SLOTY_MASTER_REF="${SLOTY_MASTER_REF:-origin/master}"

discover_sloty_backend_dir() {
  git -C "${1:-$SCRIPT_DIR}" rev-parse --show-toplevel
}

configure_repo_paths() {
  SLOTY_BACKEND_DIR="${SLOTY_BACKEND_DIR:-$(discover_sloty_backend_dir)}"
  SLOTY_BACKEND_VENV="${SLOTY_BACKEND_VENV:-${SLOTY_BACKEND_DIR}/.venv}"
  SLOTY_BACKEND_PYTHON="${SLOTY_BACKEND_PYTHON:-${SLOTY_BACKEND_VENV}/bin/python}"
  SLOTY_BACKEND_MANAGE_PY="${SLOTY_BACKEND_DIR}/manage.py"
  SLOTY_BACKEND_REQUIREMENTS="${SLOTY_BACKEND_DIR}/requirements/base.txt"
}

cleanup_deploy_snapshot() {
  if [[ -n "${SLOTY_DEPLOY_SNAPSHOT_DIR:-}" && -d "${SLOTY_DEPLOY_SNAPSHOT_DIR}" ]]; then
    rm -rf "${SLOTY_DEPLOY_SNAPSHOT_DIR}"
  fi
}

snapshot_and_reexec() {
  local repo_root snapshot_dir

  if [[ "${SLOTY_DEPLOY_RUNNING_FROM_SNAPSHOT:-}" == "1" ]]; then
    trap cleanup_deploy_snapshot EXIT
    return 0
  fi

  repo_root="$(discover_sloty_backend_dir)"
  SLOTY_BACKEND_DIR="${SLOTY_BACKEND_DIR:-$repo_root}"
  snapshot_dir="$(mktemp -d "${TMPDIR:-/tmp}/sloty-deploy.XXXXXX")"
  mkdir -p "${snapshot_dir}/lib"
  cp "${repo_root}/scripts/deploy-sloty-backend" "${snapshot_dir}/deploy-sloty-backend"
  cp "${repo_root}/scripts/write-backend-release-metadata" \
    "${snapshot_dir}/write-backend-release-metadata"
  cp "${repo_root}/scripts/lib/backend-release.sh" "${snapshot_dir}/lib/backend-release.sh"
  chmod +x "${snapshot_dir}/deploy-sloty-backend" \
    "${snapshot_dir}/write-backend-release-metadata"

  if [[ -n "${SLOTY_DEPLOY_SNAPSHOT_TRACE:-}" ]]; then
    printf '%s\n' "$snapshot_dir" >> "$SLOTY_DEPLOY_SNAPSHOT_TRACE"
  fi

  export SLOTY_DEPLOY_RUNNING_FROM_SNAPSHOT=1
  export SLOTY_DEPLOY_SNAPSHOT_DIR="$snapshot_dir"
  export SLOTY_BACKEND_DIR
  exec "${snapshot_dir}/deploy-sloty-backend" "$@"
  echo "Failed to exec snapshot deploy script." >&2
  rm -rf "$snapshot_dir"
  return 1
}

run_stage() {
  local stage="$1"
  shift

  if [[ "${SLOTY_DEPLOY_FAIL_STAGE:-}" == "$stage" ]]; then
    echo "Deploy stage failed: ${stage}" >&2
    return 1
  fi

  if [[ -n "${SLOTY_DEPLOY_STUB_DIR:-}" ]]; then
    local stub="${SLOTY_DEPLOY_STUB_DIR}/${stage}"
    if [[ -x "$stub" ]]; then
      "$stub"
    fi
    return 0
  fi

  "$@"
}

sloty_python() {
  "$SLOTY_BACKEND_PYTHON" "$@"
}

deploy_worktree() {
  if [[ -n "$(git -C "$SLOTY_BACKEND_DIR" status --porcelain)" ]]; then
    echo "Refusing to deploy: production worktree has unexpected changes." >&2
    git -C "$SLOTY_BACKEND_DIR" status --porcelain >&2
    return 1
  fi
}

deploy_origin() {
  local actual
  actual="$(git -C "$SLOTY_BACKEND_DIR" remote get-url origin)"
  if [[ "$actual" != "$SLOTY_EXPECTED_ORIGIN" &&
        "$actual" != "${SLOTY_EXPECTED_ORIGIN}.git" &&
        "${actual}.git" != "$SLOTY_EXPECTED_ORIGIN" ]]; then
    echo "Unexpected git origin: ${actual}" >&2
    echo "Expected: ${SLOTY_EXPECTED_ORIGIN}" >&2
    return 1
  fi
}

deploy_fetch() {
  git -C "$SLOTY_BACKEND_DIR" fetch --prune origin
}

deploy_verify() {
  git -C "$SLOTY_BACKEND_DIR" cat-file -e "${COMMIT_SHA}^{commit}"
}

deploy_ancestor() {
  if ! git -C "$SLOTY_BACKEND_DIR" merge-base --is-ancestor \
    "$COMMIT_SHA" "$SLOTY_MASTER_REF"; then
    echo "Refusing to deploy ${COMMIT_SHA}: not an ancestor of ${SLOTY_MASTER_REF}." >&2
    return 1
  fi
}

deploy_checkout() {
  git -C "$SLOTY_BACKEND_DIR" checkout --detach "$COMMIT_SHA"
}

deploy_verify_python() {
  if [[ ! -x "$SLOTY_BACKEND_PYTHON" ]]; then
    echo "Sloty virtualenv interpreter is missing: ${SLOTY_BACKEND_PYTHON}" >&2
    echo "Refusing to use system Python or another project's runtime." >&2
    return 1
  fi

  local python_version venv_prefix base_prefix
  python_version="$(
    sloty_python -c 'import platform; print(platform.python_version())'
  )"
  venv_prefix="$(sloty_python -c 'import sys; print(sys.prefix)')"
  base_prefix="$(sloty_python -c 'import sys; print(sys.base_prefix)')"

  if [[ "$python_version" != "$SLOTY_REQUIRED_PYTHON_VERSION" ]]; then
    echo "Wrong Sloty Python version: ${python_version}" >&2
    echo "expected=${SLOTY_REQUIRED_PYTHON_VERSION}" >&2
    return 1
  fi

  if [[ "$venv_prefix" != "$SLOTY_BACKEND_VENV" ]]; then
    echo "Unexpected Sloty virtualenv prefix: ${venv_prefix}" >&2
    echo "expected=${SLOTY_BACKEND_VENV}" >&2
    return 1
  fi

  case "$base_prefix" in
    "${SLOTY_PYTHON_RUNTIME_ROOT}"/*)
      ;;
    *)
      echo "Sloty virtualenv is not based on the dedicated Sloty Python runtime." >&2
      echo "base_prefix=${base_prefix}" >&2
      echo "expected under=${SLOTY_PYTHON_RUNTIME_ROOT}/" >&2
      echo "Refusing to modify system Python or other project runtimes." >&2
      return 1
      ;;
  esac
}

deploy_install() {
  sloty_python -m pip install -r "$SLOTY_BACKEND_REQUIREMENTS"
}

deploy_load_env() {
  if [[ ! -f "$SLOTY_BACKEND_ENV_FILE" ]]; then
    echo "Missing Sloty backend env file: ${SLOTY_BACKEND_ENV_FILE}" >&2
    return 1
  fi
  set -a
  # shellcheck disable=SC1090
  source "$SLOTY_BACKEND_ENV_FILE"
  set +a
}

deploy_check() {
  sloty_python "$SLOTY_BACKEND_MANAGE_PY" check \
    --settings="$SLOTY_DJANGO_SETTINGS"
}

deploy_migrate() {
  sloty_python "$SLOTY_BACKEND_MANAGE_PY" migrate \
    --noinput \
    --settings="$SLOTY_DJANGO_SETTINGS"
}

deploy_collectstatic() {
  sloty_python "$SLOTY_BACKEND_MANAGE_PY" collectstatic \
    --noinput \
    --settings="$SLOTY_DJANGO_SETTINGS"
}

deploy_restart() {
  systemctl restart sloty-backend.service
}

deploy_verify_service() {
  systemctl is-active --quiet sloty-backend.service
}

deploy_health() {
  local attempt http_code
  http_code="000"
  for attempt in $(seq 1 "$SLOTY_HEALTH_ATTEMPTS"); do
    http_code="$(
      curl \
        --silent \
        --show-error \
        --max-time 10 \
        --header "Host: ${SLOTY_HEALTH_HOST}" \
        --output /dev/null \
        --write-out "%{http_code}" \
        "$SLOTY_HEALTH_URL" || true
    )"
    http_code="${http_code:-000}"
    if [[ "$http_code" == "200" ]]; then
      return 0
    fi
    if [[ "$attempt" -lt "$SLOTY_HEALTH_ATTEMPTS" ]]; then
      sleep "$SLOTY_HEALTH_RETRY_SLEEP"
    fi
  done
  echo "Health check failed: expected HTTP 200 from ${SLOTY_HEALTH_URL}, got ${http_code}." >&2
  return 1
}

main() {
  configure_repo_paths
  validate_backend_release_args "$COMMIT_SHA" "$RELEASE_TAG"

  run_stage worktree deploy_worktree
  run_stage origin deploy_origin
  run_stage fetch deploy_fetch
  run_stage verify deploy_verify
  run_stage ancestor deploy_ancestor
  run_stage checkout deploy_checkout
  run_stage python deploy_verify_python
  run_stage install deploy_install
  run_stage env deploy_load_env
  run_stage check deploy_check
  run_stage migrate deploy_migrate
  run_stage collectstatic deploy_collectstatic
  run_stage restart deploy_restart
  run_stage systemd deploy_verify_service
  run_stage health deploy_health
  write_backend_release_metadata "$COMMIT_SHA" "$RELEASE_TAG"
}

if [[ "${SLOTY_DEPLOY_SOURCE_ONLY:-}" == "1" ]]; then
  configure_repo_paths
elif [[ "${SLOTY_DEPLOY_RUNNING_FROM_SNAPSHOT:-}" == "1" ]]; then
  trap cleanup_deploy_snapshot EXIT
  main
else
  validate_backend_release_args "$COMMIT_SHA" "$RELEASE_TAG"
  snapshot_and_reexec "$@"
fi
